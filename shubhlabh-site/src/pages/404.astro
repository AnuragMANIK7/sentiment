  <section class="st st--hero" aria-labelledby="nf-h">
    <div class="panel">
      <span class="mark" lang="hi">शुभ लाभ</span>
      <p class="kicker">Error 404 · not in the ledger</p>
      <h1 id="nf-h">This page went out with the lamp.</h1>
      <p class="lede">The link may be old or mistyped. The course is one click away.</p>
      <div class="actions"><a class="btn" href="/"><span>Back to the course</span> <span class="arrow" aria-hidden="true">→</span></a></div>
    </div>
  </section>
</Base>
